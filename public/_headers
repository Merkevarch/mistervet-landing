# ============================================================
# Cloudflare Pages — cabeceras de caché y seguridad
# ============================================================

# Assets de Vite (llevan hash en el nombre: si cambian, cambia la URL).
# Se pueden cachear "para siempre" de forma segura.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes públicas del blog (infografías)
/blog/*
  Cache-Control: public, max-age=604800

# Imágenes de redes sociales e iconos (cambian rara vez)
/og-image.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/manifest.json
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400

# Seguridad general (nosniff y Referrer-Policy ya los añade Cloudflare)
/*
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Panel de administración: nunca cachear
/admin/*
  Cache-Control: no-store

# MIME types correctos
/*.js
  Content-Type: application/javascript

/*.jsx
  Content-Type: application/javascript

/*.mjs
  Content-Type: application/javascript
